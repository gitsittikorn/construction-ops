rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function companyOwner(uid) { return request.auth != null && request.auth.uid == uid && activeOwner(uid); }
  function activeOwner(uid) { return exists(/databases/$(database)/documents/admins/$(uid)) && get(/databases/$(database)/documents/admins/$(uid)).data.enabled == true; }
  function member(uid) { return request.auth != null && activeOwner(uid) && exists(/databases/$(database)/documents/companies/$(uid)) && get(/databases/$(database)/documents/companies/$(uid)).data.ownerUid == uid && exists(/databases/$(database)/documents/companies/$(uid)/members/$(request.auth.uid)) && get(/databases/$(database)/documents/companies/$(uid)/members/$(request.auth.uid)).data.enabled == true && get(/databases/$(database)/documents/companies/$(uid)/members/$(request.auth.uid)).data.role in ['manager','operator']; }
  function owner(uid) { return companyOwner(uid) || member(uid); }
  function manages(uid) { return companyOwner(uid) || (member(uid) && get(/databases/$(database)/documents/companies/$(uid)/members/$(request.auth.uid)).data.role == 'manager'); }
  match /companies/{companyId} {
   allow get: if owner(companyId);
   allow list, delete: if false;
   allow create: if companyOwner(companyId) && validCompany() && request.resource.data.createdAt == request.resource.data.updatedAt;
   allow update: if companyOwner(companyId) && validCompany() && request.resource.data.createdAt == resource.data.createdAt;
   function validCompany() { let d=request.resource.data; return d.keys().hasAll(['ownerUid','name','createdAt','updatedAt']) && d.keys().hasOnly(['ownerUid','name','createdAt','updatedAt']) && d.ownerUid == companyId && d.name is string && d.name.size() > 0 && d.name.size() <= 200 && d.createdAt is string && d.updatedAt is string; }
   match /audit/{eventId} { allow read: if companyOwner(companyId); allow create: if companyOwner(companyId) && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time && request.resource.data.action in ['company-save','member-save'] && request.resource.data.keys().hasOnly(['actor','action','at','before','after']); allow update, delete: if false; }
   match /members/{memberId} {
    allow get: if request.auth != null && (request.auth.uid == memberId || companyOwner(companyId));
    allow list: if companyOwner(companyId);
    allow create, update: if companyOwner(companyId) && exists(/databases/$(database)/documents/companies/$(companyId)) && memberId != companyId && validMember();
    allow delete: if false;
    function validMember() { let d=request.resource.data; return d.keys().hasAll(['uid','name','role','enabled','updatedAt']) && d.keys().hasOnly(['uid','name','role','enabled','updatedAt']) && d.uid == memberId && d.name is string && d.name.size() > 0 && d.name.size() <= 200 && d.role in ['manager','operator'] && d.enabled is bool && d.updatedAt is string; }
   }
  }
  match /admins/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow list, write: if false; }
  match /users/{uid}/{kind}/{entityId} {
   function supported() { return kind in ['projects', 'masters', 'trips', 'workspaces']; }
   allow get: if supported() && owner(uid) && (kind != 'workspaces' || manages(uid) || resource == null || resource.data.payload.recordType in ['daily','evidence','survey']);
   allow list: if supported() && owner(uid) && (kind != 'workspaces' || manages(uid) || resource.data.payload.recordType in ['daily','evidence','survey']);
   allow create: if supported() && owner(uid) && validEnvelope() && request.resource.data.revision == 1 && (manages(uid) || operatorCreate());
   allow update: if supported() && owner(uid) && validEnvelope() && workspaceTransition() && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.operationId != resource.data.get('operationId', '') && (manages(uid) || operatorUpdate());
   allow delete: if false;
   function openEvidence(p) { let day=get(/databases/$(database)/documents/users/$(uid)/workspaces/$(p.body.sessionId)).data.payload; return day.recordType == 'daily' && day.projectId == p.projectId && day.body.state in ['open','reopened']; }
   function operatorCreate() { let p=request.resource.data.payload; return request.resource.data.deletedAt == null && (kind == 'trips' || (kind == 'workspaces' && (p.recordType == 'daily' ? p.body.state == 'open' && p.body.verifications.size() == 0 && p.body.closures.size() == 0 : p.recordType == 'evidence' && openEvidence(p)))); }
   function operatorUpdate() { let a=resource.data.payload; let b=request.resource.data.payload; return resource.data.deletedAt == null && request.resource.data.deletedAt == null && (kind == 'trips' || (kind == 'workspaces' && (b.recordType == 'daily' ? a.body.state in ['open','reopened'] && b.body.state == a.body.state && b.body.verifications == a.body.verifications && b.body.closures == a.body.closures : b.recordType == 'evidence' && openEvidence(b)))); }
   function validEnvelope() {
    let d = request.resource.data;
    let p = d.payload;
    return d.keys().hasAll(['schemaVersion','id','revision','operationId','createdAt','updatedAt','deletedAt','payload','serverUpdatedAt']) && d.keys().hasOnly(['schemaVersion','id','revision','operationId','createdAt','updatedAt','deletedAt','payload','serverUpdatedAt']) && d.schemaVersion == 1 && d.id == entityId && d.revision is int && d.revision > 0 && d.operationId is string && d.operationId.size() > 0 && d.operationId.size() <= 200 && d.createdAt is string && d.updatedAt is string && (d.deletedAt == null || d.deletedAt is string) && d.serverUpdatedAt == request.time && p is map && p.id == d.id && p.createdAt == d.createdAt && p.updatedAt == d.updatedAt && (kind == 'projects' ? validProject(p) : kind == 'masters' ? validMaster(p) : kind == 'trips' ? validTrip(p) : validWorkspace(p));
   }
   function validWorkspace(p) {
    let b = p.body;
    return p.keys().hasAll(['id','createdAt','updatedAt','recordType','projectId','name','body']) && p.keys().hasOnly(['id','createdAt','updatedAt','recordType','projectId','name','body']) && p.name is string && p.name.size() <= 500 && p.projectId is string && exists(/databases/$(database)/documents/users/$(uid)/projects/$(p.projectId)) && b is map && (p.recordType == 'daily' ? p.id == 'daily-' + p.projectId + '-' + b.date && validDaily(b) : p.recordType == 'evidence' ? validEvidence(b) : p.recordType == 'finance' ? validFinance(p, b) : p.recordType == 'survey' && validSurvey(b));
   }
   function workspaceTransition() { let a = resource.data.get('payload', {}); let b = request.resource.data.payload; return kind != 'workspaces' || (a.recordType != 'finance' && a.recordType == b.recordType && a.projectId == b.projectId && (a.recordType != 'daily' || (b.body.date == a.body.date && b.body.version > a.body.version && b.body.closures.hasAll(a.body.closures) && (a.body.state != 'closed' || (b.body.reason.size() > 0 && (b.body.state == 'reopened' || (b.body.state == 'closed' && b.body.closures.size() > a.body.closures.size()))))))); }
   function validFinance(p, b) {
    let e = b.entry;
    return b.keys().hasOnly(['kind','entry']) && b.kind in ['rate','expense'] && e is map && e.id == p.id && e.at == p.createdAt && p.createdAt == p.updatedAt && e.by == request.auth.uid && e.reason is string && e.reason.size() > 0 && e.reason.size() <= 500 && e.satang is int && e.satang >= 0 && e.satang <= 1000000000000 && request.resource.data.deletedAt == null && (b.kind == 'rate' ? validRate(e) : validExpense(p, e));
   }
   function validRate(e) {
    return e.keys().hasAll(['id','side','partyId','effectiveFrom','unit','satang','revision','reason','at','by']) && e.keys().hasOnly(['id','side','partyId','effectiveFrom','unit','satang','revision','reason','at','by']) && e.side in ['revenue','truck','driver'] && e.partyId is string && (e.side != 'revenue' || e.partyId == '') && (e.partyId == '' || (exists(/databases/$(database)/documents/users/$(uid)/masters/$(e.partyId)) && get(/databases/$(database)/documents/users/$(uid)/masters/$(e.partyId)).data.payload.kind == e.side)) && e.effectiveFrom is string && e.effectiveFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && e.unit in ['trip','m3'] && e.revision is int && e.revision > 0;
   }
   function validExpense(p, e) {
    return e.keys().hasAll(['id','date','category','truckId','satang','reason','reversesId','at','by']) && e.keys().hasOnly(['id','date','category','truckId','satang','reason','reversesId','at','by']) && e.satang > 0 && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && e.category in ['fuel','repair','other'] && e.truckId is string && (e.truckId == '' || (exists(/databases/$(database)/documents/users/$(uid)/masters/$(e.truckId)) && get(/databases/$(database)/documents/users/$(uid)/masters/$(e.truckId)).data.payload.kind == 'truck')) && e.reversesId is string && (e.reversesId == '' || validReversal(p, e));
   }
   function validReversal(p, e) {
    let old = get(/databases/$(database)/documents/users/$(uid)/workspaces/$(e.reversesId)).data.payload;
    let original = old.body.entry;
    return p.id == 'reversal-' + e.reversesId && old.recordType == 'finance' && old.projectId == p.projectId && old.body.kind == 'expense' && original.reversesId == '' && original.satang == e.satang && original.date == e.date && original.category == e.category && original.truckId == e.truckId;
   }
   function validDaily(b) { return b.keys().hasAll(['date','version','state','rows','verifications','closures','reason']) && b.date is string && b.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && b.version is int && b.version > 0 && b.state in ['open','closed','reopened'] && b.rows is list && b.rows.size() <= 200 && b.verifications is map && b.closures is list && b.closures.size() <= 100 && b.reason is string && (b.state != 'reopened' || b.reason.size() > 0) && (b.state != 'closed' || (b.closures.size() > 0 && b.closures[b.closures.size()-1].rows == b.rows && b.closures[b.closures.size()-1].verifications == b.verifications)); }
   function validEvidence(b) { return b.keys().hasAll(['sessionId','rowId','date','truckId','driverId','fingerprint','files']) && b.sessionId is string && b.rowId is string && b.date is string && b.truckId is string && b.driverId is string && b.fingerprint is string && b.files is list && b.files.size() <= 100 && exists(/databases/$(database)/documents/users/$(uid)/workspaces/$(b.sessionId)); }
   function validSurvey(b) { return b.keys().hasAll(['benchmark','elevation','datum','notes','observations','width','length','spacingX','spacingY','design','designLevel','slopeX','slopeY','allowance','cutSwell','points']) && b.benchmark is string && b.elevation is number && b.datum is string && b.notes is string && b.width is number && b.width > 0 && b.length is number && b.length > 0 && b.spacingX is number && b.spacingX > 0 && b.spacingY is number && b.spacingY > 0 && b.design in ['uniform','slope','custom'] && b.designLevel is number && b.slopeX is number && b.slopeY is number && b.allowance is number && b.allowance >= 0 && b.allowance <= 200 && b.cutSwell is number && b.cutSwell >= 0 && b.cutSwell <= 200 && b.observations is list && b.points is list && b.points.size() <= 2500; }
   function validProject(p) {
    return p.keys().hasAll(['id','createdAt','updatedAt','name','customer','location','startDate','endDate','status','description']) && p.keys().hasOnly(['id','createdAt','updatedAt','name','customer','location','latitude','longitude','startDate','endDate','status','description']) && p.name is string && p.name.size() > 0 && p.name.size() <= 500 && p.customer is string && p.location is string && p.startDate is string && p.endDate is string && p.description is string && p.description.size() <= 10000 && p.status in ['draft','active','completed','archived'] && (!p.keys().hasAny(['latitude','longitude']) || (p.latitude is number && p.latitude >= -90 && p.latitude <= 90 && p.longitude is number && p.longitude >= -180 && p.longitude <= 180));
   }
   function validMaster(p) {
    return p.keys().hasAll(['id','createdAt','updatedAt','kind','name','detail','capacity','active']) && p.keys().hasOnly(['id','createdAt','updatedAt','kind','name','detail','capacity','active','province','phone','truckType','tagIds']) && p.kind in ['truck','driver','source','customer','soilType','tag'] && p.name is string && p.name.size() > 0 && p.name.size() <= 200 && p.detail is string && p.detail.size() <= 10000 && p.capacity is number && p.capacity >= 0 && p.active is bool && (!('province' in p) || p.province is string) && (!('phone' in p) || p.phone is string) && (!('truckType' in p) || p.truckType in ['six-wheel','ten-wheel','other']) && (!('tagIds' in p) || (p.tagIds is list && p.tagIds.size() <= 100));
   }
   function validTrip(p) {
    return p.keys().hasAll(['id','createdAt','updatedAt','projectId','date','time','truckId','driverId','sourceId','soilType','notes','revision']) && p.keys().hasOnly(['id','createdAt','updatedAt','projectId','date','time','truckId','driverId','sourceId','soilType','notes','revision','capacityPerTrip']) && (!('capacityPerTrip' in p) || (p.capacityPerTrip is number && p.capacityPerTrip > 0)) && p.projectId is string && p.projectId.size() > 0 && p.truckId is string && p.truckId.size() > 0 && p.driverId is string && p.sourceId is string && p.soilType is string && p.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && p.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && p.notes is string && p.notes.size() <= 10000 && p.revision is int && p.revision >= 1 && exists(/databases/$(database)/documents/users/$(uid)/projects/$(p.projectId)) && exists(/databases/$(database)/documents/users/$(uid)/masters/$(p.truckId)) && get(/databases/$(database)/documents/users/$(uid)/masters/$(p.truckId)).data.payload.kind == 'truck' && (p.driverId == '' || (exists(/databases/$(database)/documents/users/$(uid)/masters/$(p.driverId)) && get(/databases/$(database)/documents/users/$(uid)/masters/$(p.driverId)).data.payload.kind == 'driver')) && (p.sourceId == '' || (exists(/databases/$(database)/documents/users/$(uid)/masters/$(p.sourceId)) && get(/databases/$(database)/documents/users/$(uid)/masters/$(p.sourceId)).data.payload.kind == 'source'));
   }
  }
  match /users/{uid}/uniqueKeys/{key} {
   allow read: if owner(uid);
   allow create: if manages(uid) && validClaim();
   allow update: if manages(uid) && validClaim() && (resource.data.entityId == request.resource.data.entityId || resource.data.active == false);
   allow delete: if false;
   function validClaim() { return request.resource.data.keys().hasOnly(['entityId','active']) && request.resource.data.entityId is string && request.resource.data.active is bool && existsAfter(/databases/$(database)/documents/users/$(uid)/masters/$(request.resource.data.entityId)); }
  }
  match /users/{uid}/audit/{eventId} { allow read: if owner(uid); allow create: if owner(uid) && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time; allow update, delete: if false; }
  match /users/{uid}/driveFolders/{key} {
   allow read: if owner(uid);
   allow create: if manages(uid) && (
    (key == 'root' && request.resource.data.keys().hasAll(['rootId','projectsId']) && request.resource.data.keys().hasOnly(['rootId','projectsId']) && request.resource.data.rootId is string && request.resource.data.projectsId is string && request.resource.data.rootId.size() > 0 && request.resource.data.projectsId.size() > 0) ||
    (key != 'root' && request.resource.data.keys().hasAll(['projectId','documentsId']) && request.resource.data.keys().hasOnly(['projectId','documentsId']) && request.resource.data.projectId is string && request.resource.data.documentsId is string && request.resource.data.projectId.size() > 0 && request.resource.data.documentsId.size() > 0)
   );
   allow update, delete: if false;
  }
  match /users/{uid}/evidenceFolders/{key} {
   allow read: if owner(uid);
   allow create: if owner(uid) && request.resource.data.keys().hasAll(['id','parentId','name']) && request.resource.data.keys().hasOnly(['id','parentId','name']) && request.resource.data.id is string && request.resource.data.id.size() > 0 && request.resource.data.parentId is string && request.resource.data.parentId.size() > 0 && request.resource.data.name is string && request.resource.data.name.size() <= 500;
   allow update, delete: if false;
  }
  match /users/{uid}/documents/{documentId} {
   allow read: if owner(uid);
   allow create: if owner(uid) && request.resource.data.keys().hasAll(['id','owner','projectId','tripId','fileId','folderId','name','mimeType','size','createdAt','status','uploadedAt']) && request.resource.data.keys().hasOnly(['id','owner','projectId','tripId','fileId','folderId','name','mimeType','size','createdAt','status','uploadedAt','evidenceId','driverId','truckId','workDate','category']) && request.resource.data.id == documentId && request.resource.data.owner == uid && request.resource.data.projectId is string && request.resource.data.projectId.size() > 0 && request.resource.data.tripId is string && request.resource.data.fileId is string && request.resource.data.fileId.size() > 0 && request.resource.data.folderId is string && request.resource.data.folderId.size() > 0 && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 1024 && request.resource.data.mimeType is string && request.resource.data.mimeType.matches('^(image/.*|application/pdf)$') && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 104857600 && request.resource.data.createdAt is string && request.resource.data.status == 'synced' && request.resource.data.uploadedAt == request.time && (!('evidenceId' in request.resource.data) || (request.resource.data.evidenceId is string && request.resource.data.driverId is string && request.resource.data.truckId is string && request.resource.data.workDate is string && request.resource.data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.category in ['driver-photo','signature','trip-slip']));
   allow update, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
